# Copy to .env (git-ignored) and adjust. Read by both Vite and docker compose.

# Backend the Vite dev proxy sends /bives/*.php to.
#   http://localhost:8088  - the local `docker compose` stack (default)
#   https://merge-proto.bio.informatik.uni-rostock.de - the production host
BIVES_PROXY=http://localhost:8088

# uid/gid the `web` container runs as, so files it writes into the repo
# (node_modules, public/mathjax) are owned by you rather than root.
# Set these to the output of `id -u` and `id -g`.
DOCKER_UID=1000
DOCKER_GID=1000
